      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a href=\"#home\">Home</a><a href=\"#menu\">Menu</a><a href=\"#story\">Our story</a><a class=\"ds-nav-directions\" href=\"#visit\">Get directions</a></nav>",
